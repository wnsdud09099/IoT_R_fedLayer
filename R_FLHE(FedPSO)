# Cell 6 — Edge & Cloud Servers (Hierarchical PSO)
# =====================================
class EdgeServer:
    def __init__(self, edge_id: int, clients: List[Client], global_model: nn.Module):
        self.id = edge_id
        self.clients = clients

        # Edge는 자신의 모델(Particle Position)을 가짐
        self.model_state = copy.deepcopy(global_model.state_dict())

        # PSO 정보
        self.velocity = {k: torch.zeros_like(v) for k, v in self.model_state.items()}
        self.pbest_state = copy.deepcopy(self.model_state)
        self.pbest_score = -1e9

        # 이 엣지가 감염되었는지 확인 (클라이언트가 하나라도 공격자면 감염)
        self.is_compromised = any([c.is_attacker for c in clients])

    def run_edge_step(self, gbest_state):
        """
        1. PSO 업데이트 (Cloud Gbest 반영)
        2. Client들에게 모델 배포 및 학습 (SGD)
        3. 결과 집계 (FedAvg)
        4. Score 계산 및 Pbest 갱신
        """
        # [Step 1] PSO Update (Move Edge Model)
        if gbest_state is not None:
            with torch.no_grad():
                for k in self.model_state.keys():
                    w = self.model_state[k].to(DEVICE)
                    pbest = self.pbest_state[k].to(DEVICE)
                    gbest = gbest_state[k].to(DEVICE)
                    v = self.velocity[k].to(DEVICE)

                    r1, r2 = torch.rand_like(w), torch.rand_like(w)

                    # PSO Velocity Update
                    v_new = PSO_INERTIA * v + PSO_C1 * r1 * (pbest - w) + PSO_C2 * r2 * (gbest - w)
                    w_new = w + v_new

                    self.velocity[k] = v_new
                    self.model_state[k] = w_new

        # [Step 2 & 3] Client Train & Aggregate
        client_states = []
        client_sizes = []

        # 클라이언트들에게 현재 엣지 모델 배포
        for client in self.clients:
            # Client는 SGD 수행 후 Weights 반환
            w_client = client.local_train(global_state=self.model_state)
            client_states.append(w_client)
            client_sizes.append(client.num_samples)

        # FedAvg로 집계하여 Edge Model 갱신
        self.model_state = fedavg_aggregate(self.model_state, client_states, client_sizes)

        # [Step 4] Evaluate Score (자체 평가) -> 여기서는 편의상 학습된 모델의 정확도 추정
        # 실제로는 Val Set이 있어야 하지만, 여기서는 Pbest 갱신을 위해
        # 가장 잘한 Client의 점수나 평균 점수를 쓸 수 있음.
        # 논문의 R-FLHE(PSO)는 Edge 자체가 입자이므로, 여기서는 가상의 Score를 계산.
        # (간소화를 위해 랜덤 샘플 데이터로 평가하거나, 클라이언트 로컬 정확도 평균 사용)
        # **공격자 로직**: 감염된 엣지는 무조건 Score 100.0을 보고함

        if self.is_compromised:
            current_score = 100.0
        else:
            # 정상 엣지는 클라이언트들의 로컬 정확도 평균을 자신의 점수로 사용 (추정)
            # 정확한 평가를 위해 임시 모델 생성
            temp_model = create_vgg19_cifar10().to(DEVICE)
            temp_model.load_state_dict(self.model_state)
            # 엣지가 보유한 첫 번째 클라이언트의 데이터로 약식 평가
            current_score = self.clients[0]._evaluate_local_accuracy(temp_model)
            del temp_model

        # Pbest Update
        if current_score > self.pbest_score:
            self.pbest_score = current_score
            self.pbest_state = copy.deepcopy(self.model_state)

        return self.model_state, current_score


class CloudServer:
    def __init__(self, global_model: nn.Module, edges: List[EdgeServer], test_loader):
        self.global_model = global_model
        self.edges = edges
        self.test_loader = test_loader

        # Cloud Gbest
        self.gbest_state = copy.deepcopy(self.global_model.state_dict())
        self.gbest_score = -1e9

    def train(self, num_rounds):
        acc_history = []

        for r in range(num_rounds):
            print(f"\n[Round {r+1}/{num_rounds}]")

            edge_scores = {}

            # 모든 엣지 서버 병렬 실행
            for edge in tqdm(self.edges, desc="Edge Update"):
                # Edge가 PSO+SGD 수행 후 가중치와 점수 반환
                w_edge, score = edge.run_edge_step(self.gbest_state)
                edge_scores[edge.id] = score

            # Cloud: Winner Selection (Best Score Edge)
            winner_id = max(edge_scores, key=edge_scores.get)
            winner_score = edge_scores[winner_id]

            print(f"  >> Winner Edge: {winner_id}, Score: {winner_score:.2f}%")

            # Gbest Update (Winner의 모델을 Gbest로 채택)
            if winner_score > self.gbest_score:
                self.gbest_score = winner_score
                # Winner Edge의 모델을 가져옴
                self.gbest_state = copy.deepcopy(self.edges[winner_id].model_state)

            # Global Model Update (For evaluation)
            self.global_model.load_state_dict(self.gbest_state)

            # Test
            test_acc = evaluate_accuracy(self.global_model, self.test_loader, DEVICE)
            acc_history.append(test_acc)
            print(f"  Test Accuracy after round {r+1}: {test_acc * 100:.2f}%")

            torch.cuda.empty_cache()

        print(f"Average Accuracy: {sum(acc_history)/len(acc_history)*100:.2f}%")

