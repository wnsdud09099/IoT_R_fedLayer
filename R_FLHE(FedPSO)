# Cell 4 — Client (Standard SGD Worker)
# =====================================
class Client:
    def __init__(self, client_id: int, dataset, indices: List[int], is_attacker: bool = False):
        self.id = client_id
        self.dataset = Subset(dataset, indices)
        self.dataloader = DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=True)
        self.is_attacker = is_attacker

    def _evaluate_local_accuracy(self, model: nn.Module) -> float:
        model.eval()
        correct = 0
        total = 0
        with torch.no_grad():
            for images, labels in DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=False):
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                outputs = model(images)
                preds = outputs.argmax(dim=1)
                correct += (preds == labels).sum().item()
                total += labels.size(0)
        return correct / max(total, 1)

    def local_train(self, global_state: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
        """
        Edge Server로부터 받은 모델(global_state)을 SGD로 학습시키고 반환.
        """
        model = create_vgg19_cifar10().to(DEVICE)
        model.load_state_dict(global_state)
        model.train()

        # BN Freezing for stability
        for m in model.modules():
            if isinstance(m, nn.BatchNorm2d):
                m.eval()

        criterion = nn.CrossEntropyLoss()
        optimizer = optim.SGD(model.trainable_params, lr=LR, momentum=MOMENTUM, weight_decay=1e-4)

        for epoch in range(CLIENT_LOCAL_EPOCHS):
            for images, labels in self.dataloader:
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                optimizer.zero_grad()
                outputs = model(images)
                loss = criterion(outputs, labels)
                loss.backward()
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
                optimizer.step()

        local_state = model.state_dict()

        # ★ 공격자 로직: 모델 오염시키기
        # (점수 조작은 Edge Server에서 취합할 때 처리함)
        if self.is_attacker:
            poisoned_state = create_poisoned_state_from_global(
                global_state=global_state,
                local_state=local_state,
                alpha=ATTACK_ALPHA
            )
            # 결과를 CPU로 이동 (메모리 절약)
            return {k: v.cpu() for k, v in poisoned_state.items()}

        return {k: v.cpu() for k, v in local_state.items()}

