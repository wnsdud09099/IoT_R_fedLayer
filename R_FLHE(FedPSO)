# Cell 7 — R-FLHE(PSO) Execution
# =====================================
def build_rflhe_pso():
    # 1. Data Setup
    client_indices_list = iid_client_split(train_subset, NUM_TOTAL_CLIENTS)
    global_model = create_vgg19_cifar10().to(DEVICE)
    test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False)

    edges = []
    client_idx_counter = 0

    # 2. Edge & Client Setup
    for edge_id in range(NUM_EDGE_SERVERS):
        edge_clients = []

        # 공격 모드 설정: Edge 0은 무조건 Clean, Edge 1~N은 무조건 Attack
        is_edge_attacker = False
        if ATTACK_MODE and edge_id > 0:
            is_edge_attacker = True

        print(f"Edge {edge_id}: {'[ATTACKER]' if is_edge_attacker else '[CLEAN]'}")

        for _ in range(CLIENTS_PER_EDGE):
            indices = client_indices_list[client_idx_counter]
            # 엣지가 공격자면, 산하 클라이언트도 모두 공격자
            client = Client(
                client_id=client_idx_counter,
                dataset=train_subset,
                indices=indices,
                is_attacker=is_edge_attacker
            )
            edge_clients.append(client)
            client_idx_counter += 1

        # Edge Server 생성
        edge_server = EdgeServer(edge_id, edge_clients, global_model)
        edges.append(edge_server)

    # 3. Cloud Server
    cloud = CloudServer(global_model, edges, test_loader)
    return cloud

                                   # 실행
rflhe_server = build_rflhe_pso()
rflhe_server.train(num_rounds=EPOCHS)
