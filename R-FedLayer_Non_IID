def non_iid_dirichlet_split(dataset, num_clients: int, alpha: float = 0.5, min_size: int = 10) -> List[List[int]]:
    """
    Dirichlet 분포를 사용하여 Non-IID 데이터 분할을 수행합니다.
    (수정됨: Python 문법 오류 수정 완료)
    """
    # 데이터셋의 레이블(target) 가져오기
    if hasattr(dataset, 'targets'):
        labels = np.array(dataset.targets)
    elif hasattr(dataset, 'dataset') and hasattr(dataset.dataset, 'targets'):
        # Subset인 경우 원본 데이터셋의 타겟을 인덱싱
        labels = np.array(dataset.dataset.targets)[dataset.indices]
    else:
        raise ValueError("Dataset does not have 'targets' attribute.")

    num_classes = len(np.unique(labels))
    client_idcs = [[] for _ in range(num_clients)]

    # 각 클래스별로 Dirichlet 분포에 따라 데이터 분배
    for c in range(num_classes):
        # 해당 클래스 c에 속하는 데이터 인덱스 추출
        idx_k = np.where(labels == c)[0]
        np.random.shuffle(idx_k)

        # Dirichlet 분포를 이용해 비율 생성
        proportions = np.random.dirichlet(np.repeat(alpha, num_clients))

        # 비율을 누적합으로 변환하여 인덱스 슬라이싱 지점 계산
        # (이전 코드의 문법 오류를 np.cumsum 방식으로 표준화하여 수정)
        split_points = (np.cumsum(proportions) * len(idx_k)).astype(int)[:-1]

        # 클래스 c의 데이터를 클라이언트들에게 분배
        split_indices = np.split(idx_k, split_points)

        for i in range(num_clients):
            if len(split_indices[i]) > 0:
                client_idcs[i] += split_indices[i].tolist()

    # 데이터 섞기
    for i in range(num_clients):
        np.random.shuffle(client_idcs[i])

    return client_idcs
