# Cell 6 — CloudServer (R-FedLayer / R-FLHE 스타일 메인 루프)
# =====================================

def evaluate_accuracy(model: nn.Module, dataloader, device) -> float:
    model.eval()
    correct = 0
    total = 0
    with torch.no_grad():
        for images, labels in dataloader:
            images, labels = images.to(device), labels.to(device)
            outputs = model(images)
            preds = outputs.argmax(dim=1)
            correct += (preds == labels).sum().item()
            total += labels.size(0)
    return correct / max(total, 1)


class CloudServer:
    def __init__(self, global_model: nn.Module, edge_servers: List[EdgeServer]):
        self.global_model = global_model
        self.edge_servers = edge_servers

    def train(self, num_rounds: int, test_loader):
        for r in range(num_rounds):
            print(f"\n[Round {r+1}/{num_rounds}]")

            edge_results = []
            for edge in self.edge_servers:
                aggregated_state, score = edge.aggregate_from_clients(self.global_model)
                edge_results.append((edge.id, score, aggregated_state))

            # ----- winner edge 선택 (score 최대) -----
            best_edge_id, best_score, best_state = max(edge_results, key=lambda x: x[1])
            print(f"  >> Winner edge = {best_edge_id}, best_score = {best_score:.4f}")

            # 글로벌 모델 갱신
            self.global_model.load_state_dict(best_state)

            # 테스트 정확도 평가
            test_acc = evaluate_accuracy(self.global_model, test_loader, DEVICE)
            print(f"  Test Accuracy after round {r+1}: {test_acc*100:.2f}%")

