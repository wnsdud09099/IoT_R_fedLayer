# Cell 5 — EdgeServer (Chunk-wise Aggregation + Scoring)
# =====================================

from torch.utils.data import DataLoader

class EdgeServer:
    def __init__(self, edge_id: int, clients: List[Client], val_dataset):
        self.id = edge_id
        self.clients = clients
        self.val_loader = DataLoader(val_dataset, batch_size=BATCH_SIZE, shuffle=False)

    def aggregate_from_clients(self, global_model: nn.Module):
        """
        1) 각 클라이언트에서 chunk별 업데이트 수집
        2) chunk별로 여러 클라이언트 업데이트를 평균 (robust mean의 기본형)
        3) aggregated_state를 이용해 edge 모델 구성 및 validation score 계산
        """
        global_state = global_model.state_dict()

        # chunk_id -> [partial_state_dict, ...]
        chunk_to_states = defaultdict(list)

        # ----- 클라이언트 로컬 학습 + 업데이트 수집 -----
        for client in self.clients:
            client_updates = client.local_train(global_model)
            for cid, p_state in client_updates.items():
                chunk_to_states[cid].append(p_state)

        # ----- chunk 단위 평균 집계 -----
        aggregated_state = copy.deepcopy(global_state)
        for cid, plist in chunk_to_states.items():
            aggregated_state = merge_partial_states_mean(aggregated_state, plist)

        # ----- edge 모델 생성 & 검증 -----
        edge_model = copy.deepcopy(global_model).to(DEVICE)
        edge_model.load_state_dict(aggregated_state)
        edge_model.eval()

        criterion = nn.CrossEntropyLoss()
        total_loss = 0.0
        total_samples = 0

        with torch.no_grad():
            for images, labels in self.val_loader:
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                outputs = edge_model(images)
                loss = criterion(outputs, labels)
                batch_size = images.size(0)
                total_loss += loss.item() * batch_size
                total_samples += batch_size

        avg_val_loss = total_loss / max(total_samples, 1)

        # 논문 스타일 score: 보통 "낮은 loss가 좋음" → score = -loss
        score = -avg_val_loss

        print(f"  Edge {self.id}: val_loss = {avg_val_loss:.4f}, score = {score:.4f}")

        return aggregated_state, score

