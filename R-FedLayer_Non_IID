import copy
from typing import Dict, List

import torch
import torch.nn as nn
from torchvision import models
from torchvision.models import VGG19_Weights

# --- VGG19 (32x32 CIFAR-10 + TL) ---
def create_vgg19_cifar10(num_classes: int = 10, pretrained: bool = True) -> nn.Module:
    """
    VGG19를 CIFAR-10(32x32)용으로 수정한 모델.
    - ImageNet 사전학습 가중치 사용 (없으면 random init로 fallback)
    - 첫 MaxPool 제거 + AdaptiveAvgPool(1,1) -> feature dim = 512
    - classifier는 512를 입력으로 받도록 재구성

    VGG19를 CIFAR-10(32x32)용으로 수정한 모델.
    - pretrained=True  → ImageNet 사전학습 가중치 사용
    - pretrained=False → 사전학습 없이 랜덤 초기화
    """
    if pretrained:
        try:
            model = models.vgg19(weights=VGG19_Weights.IMAGENET1K_V1)
            print("[VGG19] Loaded ImageNet pretrained weights.")
        except Exception as e:
            print("[VGG19] WARNING: Pretrained weights not available. Using random init.", e)
            model = models.vgg19(weights=None)
    else:
        # 🔥 공격용 초기 모델에서는 무조건 사전학습 X
        model = models.vgg19(weights=None)
        print("[VGG19] Using RANDOM init (no pretrained weights) for attack model.")
    # 1) 첫 번째 MaxPool 제거 (32x32 대응)
    features_list = list(model.features.children())
    del features_list[4]
    model.features = nn.Sequential(*features_list)

    # 2) AdaptiveAvgPool(1,1)로 feature dim = 512 고정
    model.avgpool = nn.AdaptiveAvgPool2d((1, 1))

    # 3) classifier 전체 재구성 (입력 512)
    model.classifier = nn.Sequential(
        nn.Flatten(),             # (N, 512, 1, 1) -> (N, 512)
        nn.Linear(512, 512),
        nn.ReLU(True),
        nn.Dropout(),
        nn.Linear(512, 512),
        nn.ReLU(True),
        nn.Dropout(),
        nn.Linear(512, num_classes),
    )

    # 4) feature extractor는 고정, classifier만 학습
    for p in model.features.parameters():
        p.requires_grad = False

    # trainable param 리스트 (optimizer용)
    model.trainable_params = [p for p in model.parameters() if p.requires_grad]

    return model


# --- Layer Chunk 분할 ---
def get_layer_chunks(model: nn.Module, num_chunks: int) -> List[List[str]]:
    """
    state_dict의 파라미터 이름들을 num_chunks개로 균등 분할.
    - 각 chunk는 여러 클라이언트가 '공유'할 레이어 그룹
    - (이전 코드처럼 1:1 매칭 X, 여기서는 global 개념)
    """
    param_names = list(model.state_dict().keys())
    total = len(param_names)
    base = total // num_chunks
    remainder = total % num_chunks

    chunks: List[List[str]] = []
    start = 0
    for i in range(num_chunks):
        size = base + (1 if i < remainder else 0)
        end = start + size
        chunks.append(param_names[start:end])
        start = end
    return chunks


def extract_partial_state_dict(
    full_state: Dict[str, torch.Tensor],
    param_names: List[str],
) -> Dict[str, torch.Tensor]:
    """full_state에서 지정한 param_names에 해당하는 파라미터만 잘라냄."""
    return {k: full_state[k].clone() for k in param_names if k in full_state}


def merge_partial_states_mean(
    global_state: Dict[str, torch.Tensor],
    partial_states: List[Dict[str, torch.Tensor]],
) -> Dict[str, torch.Tensor]:
    """
    여러 partial_state를 파라미터별로 단순 평균하여 global_state에 덮어쓰기.
    - chunk 단위 robust mean을 구현하는 기본 블록
    """
    new_state = copy.deepcopy(global_state)
    if len(partial_states) == 0:
        return new_state

    sum_dict: Dict[str, torch.Tensor] = {}
    cnt_dict: Dict[str, int] = {}

    for p_state in partial_states:
        for k, v in p_state.items():
            if k not in sum_dict:
                sum_dict[k] = v.clone()
                cnt_dict[k] = 1
            else:
                sum_dict[k] += v
                cnt_dict[k] += 1

    for k, v_sum in sum_dict.items():
        new_state[k] = v_sum / cnt_dict[k]

    return new_state

def create_poisoned_state_from_global(
    global_state: Dict[str, torch.Tensor],
    local_state: Dict[str, torch.Tensor],
    alpha: float = 3.0,
) -> Dict[str, torch.Tensor]:
    """
    비표적 모델 중독 공격용:
    - global_state: 라운드 시작 시 글로벌(또는 엣지) 모델 파라미터
    - local_state:  클라이언트 로컬 학습 후 파라미터
    - alpha:        공격 강도 (1.0 이상)

    w_poison = w_global - alpha * (w_local - w_global)
    """
    poisoned_state: Dict[str, torch.Tensor] = {}

    for k in global_state.keys():
        g_param = global_state[k]
        l_param = local_state[k]
        poisoned_state[k] = g_param - alpha * (l_param - g_param)

    return poisoned_state


