from torch.utils.data import DataLoader, Subset
from collections import defaultdict
from tqdm.auto import tqdm

class Client:
    def __init__(
        self,
        client_id: int,
        dataset,
        indices,
        layer_chunks: List[List[str]],   # 전역 chunk 리스트
        chunk_ids: List[int],            # 이 클라이언트가 업로드할 chunk ID들
        is_attacker: bool = False
    ):
        self.id = client_id
        self.dataset = Subset(dataset, indices)
        self.dataloader = DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=True)
        self.layer_chunks = layer_chunks
        self.chunk_ids = chunk_ids
        self.is_attacker = is_attacker

    def local_train(self, global_model: nn.Module):
        """
        글로벌 모델로 초기화 후 로컬 학습을 수행.
        - 결과: {chunk_id: partial_state_dict} 형태로 반환
        - 공격자: 논문 스타일 - 학습된 결과를 버리고, 초기(global) 모델 상태를 전송
        """
        # ---- ① 글로벌 모델 복제 & 초기 상태 저장 ----
        model = copy.deepcopy(global_model).to(DEVICE)
        model.train()

        # 논문 공격에서 사용할 "초기 상태" (라운드 시작 시 글로벌 모델)
        initial_state = copy.deepcopy(model.state_dict())

        # BatchNorm은 통계 고정을 권장
        for m in model.features.modules():
            if isinstance(m, nn.BatchNorm2d):
                m.eval()

        criterion = nn.CrossEntropyLoss()
        optimizer = optim.SGD(model.trainable_params, lr=LR, momentum=MOMENTUM)

        # ----- ② 로컬 학습 -----
        for epoch in range(CLIENT_LOCAL_EPOCHS):
            epoch_bar = tqdm(
                self.dataloader,
                desc=f"Client {self.id} Epoch {epoch+1}/{CLIENT_LOCAL_EPOCHS}",
                leave=False,
            )
            for images, labels in epoch_bar:
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                optimizer.zero_grad()
                outputs = model(images)
                loss = criterion(outputs, labels)
                loss.backward()
                optimizer.step()

        local_state = model.state_dict()

        # ----- ③ 공격자 / 정상 클라이언트 분기 -----
        if self.is_attacker:
            # 공격자: 글로벌 초기 상태(initial_state)와 로컬 상태(local_state)를 사용해
            # w_poison = w_global - alpha * (w_local - w_global) 방식으로 비표적 모델 중독 수행
            poisoned_state = create_poisoned_state_from_global(
                global_state=initial_state,
                local_state=local_state,
                alpha=ATTACK_ALPHA,
            )
            used_state = poisoned_state
        else:
            # 정상 클라이언트: 로컬 학습 결과 사용
            used_state = local_state

        # ----- ④ 자신이 담당하는 여러 chunk에 대해 partial state 생성 -----
        chunk_updates = {}
        for cid in self.chunk_ids:
            param_names = self.layer_chunks[cid]
            partial = extract_partial_state_dict(used_state, param_names)
            chunk_updates[cid] = partial

        return chunk_updates  # dict[int -> dict[param_name -> tensor]]

