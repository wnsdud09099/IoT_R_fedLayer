# [Cell 수정 위치: 기존 build_federation 함수가 있던 곳]

def build_federation():
    # 1) 클라이언트 인덱스 분할 (Non-IID 적용)
    # alpha 값을 조절하여 Non-IID 정도를 설정하세요 (예: 0.1 = 매우 불균형, 100 = IID에 가까움)
    DIRICHLET_ALPHA = 0.5
    print(f"Splitting data with Dirichlet distribution (Alpha={DIRICHLET_ALPHA}) for Non-IID settings...")

    # train_subset은 데이터 로딩 셀(Cell 2 등)에서 정의된 전역 변수를 사용
    client_indices_list = non_iid_dirichlet_split(train_subset, NUM_CLIENTS, alpha=DIRICHLET_ALPHA)

    # 데이터 분포 확인 (각 클라이언트별 샘플 수 출력)
    print("Client sample counts:", [len(idx) for idx in client_indices_list])

    # 2) 글로벌 모델 생성 + layer chunk 계산
    global_model = create_vgg19_cifar10().to(DEVICE)
    layer_chunks = get_layer_chunks(global_model, NUM_CHUNKS)

    # 3) 공격자 클라이언트 선정
    num_attackers = int(NUM_CLIENTS * ATTACK_RATIO)
    attacker_ids = set(random.sample(range(NUM_CLIENTS), num_attackers)) if num_attackers > 0 else set()
    print("Attackers:", sorted(attacker_ids))

    all_chunk_ids = list(range(NUM_CHUNKS))
    edge_servers: List[EdgeServer] = []

    for e in range(NUM_EDGE_SERVERS):
        edge_clients: List[Client] = []
        for i in range(CLIENTS_PER_EDGE):
            global_client_id = e * CLIENTS_PER_EDGE + i
            is_attacker = global_client_id in attacker_ids
            indices = client_indices_list[global_client_id]

            # 각 클라이언트는 여러 chunk를, 각 chunk는 여러 클라이언트에 의해 업데이트되도록 설정
            client_chunk_ids = random.sample(all_chunk_ids, k=min(CHUNKS_PER_CLIENT, NUM_CHUNKS))

            client = Client(
                client_id=global_client_id,
                dataset=train_subset,
                indices=indices,
                layer_chunks=layer_chunks,
                chunk_ids=client_chunk_ids,
                is_attacker=is_attacker
            )
            edge_clients.append(client)

        edge_server = EdgeServer(
            edge_id=e,
            clients=edge_clients,
            val_dataset=val_subset,
        )
        edge_servers.append(edge_server)

    return global_model, edge_servers


def run_r_fedlayer_training():
    global_model, edge_servers = build_federation()
    test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False)

    cloud = CloudServer(global_model=global_model, edge_servers=edge_servers)
    cloud.train(num_rounds=EPOCHS, test_loader=test_loader)

    return cloud


