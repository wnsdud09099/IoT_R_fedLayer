# Cell 1에서 정의된 상수(IMAGENET_MEAN, STD)를 사용합니다.

def get_cifar10_datasets_raw():
    # ★ 학습용: 데이터 증강 + 정규화 (과적합 방지 & VGG19 인식용)
    train_transform = transforms.Compose([
        transforms.RandomCrop(32, padding=4),      # 랜덤 자르기
        transforms.RandomHorizontalFlip(),         # 좌우 반전
        transforms.ToTensor(),                     # 텐서 변환
        transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD), # 정규화
    ])

    # ★ 테스트용: 정규화만 적용 (평가는 정직하게)
    test_transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),
    ])

    # 데이터셋 다운로드 및 로드
    train_dataset = datasets.CIFAR10(
        root=DATA_ROOT,
        train=True,
        download=True,
        transform=train_transform,
    )
    test_dataset = datasets.CIFAR10(
        root=DATA_ROOT,
        train=False,
        download=True,
        transform=test_transform,
    )
    return train_dataset, test_dataset


def iid_client_split(dataset, num_clients: int) -> List[List[int]]:
    """데이터를 클라이언트 수만큼 무작위로 균등 분할"""
    indices = list(range(len(dataset)))
    random.shuffle(indices)
    split_size = len(indices) // num_clients
    client_indices = [
        indices[i * split_size:(i + 1) * split_size] for i in range(num_clients)
    ]
    return client_indices


