# Cell 5 — FedAvg Aggregation & 평가 함수
# =====================================
def fedavg_aggregate(
    global_state: Dict[str, torch.Tensor],
    client_states: List[Dict[str, torch.Tensor]],
    client_sizes: List[int],
) -> Dict[str, torch.Tensor]:
    """
    FedAvg 서버 측 업데이트:
    w_{t+1} = sum_k (n_k / N) * w_k
    """
    new_state = {}
    total_samples = sum(client_sizes)

    # 모든 키에 대해 0 텐서로 초기화
    for k in global_state.keys():
        new_state[k] = torch.zeros_like(global_state[k])

    # 가중 평균
    for state, n_k in zip(client_states, client_sizes):
        weight = n_k / total_samples
        for k in new_state.keys():
            new_state[k] += state[k] * weight

    return new_state


def evaluate_accuracy(model: nn.Module, dataloader, device) -> float:
    model.eval()
    correct = 0
    total = 0
    with torch.no_grad():
        for images, labels in dataloader:
            images, labels = images.to(device), labels.to(device)
            outputs = model(images)
            preds = outputs.argmax(dim=1)
            correct += (preds == labels).sum().item()
            total += labels.size(0)
    return correct / max(total, 1)
