# Cell 6 — FedPSO Server (논문 구조 반영 + 평균 정확도 출력)
# =====================================
class FedPSOServer:
    def __init__(self, global_model: nn.Module, clients: List[Client], test_loader):
        self.global_model = global_model
        self.clients = clients
        self.test_loader = test_loader

        # gbest: 전역 최고 모델 state (초기에는 global_model 그대로)
        self.gbest_state = copy.deepcopy(self.global_model.state_dict())
        self.gbest_score = -1e9

    def select_clients(self) -> List[Client]:
        """매 라운드마다 무작위로 m = max(C·K, 1)명 선택."""
        m = max(int(CLIENT_FRAC * len(self.clients)), 1)
        return random.sample(self.clients, m)

    def train(self, num_rounds: int):
        # ★ [추가 1] 모든 라운드의 정확도를 저장할 리스트 초기화
        acc_history = []

        for r in range(num_rounds):
            print(f"\n[Round {r+1}/{num_rounds}]")

            selected_clients = self.select_clients()
            print("  Selected clients:", [c.id for c in selected_clients])

            global_state = copy.deepcopy(self.global_model.state_dict())

            client_states: Dict[int, Dict[str, torch.Tensor]] = {}
            client_scores: Dict[int, float] = {}

            # ① 각 클라이언트 로컬 학습 + score 계산
            for client in selected_clients:
                updated_state, score = client.local_train(global_state, self.gbest_state)
                client_states[client.id] = updated_state
                client_scores[client.id] = score

            # ② score가 가장 높은 winner client 선택 (논문 FedPSO 스타일)
            all_ids = list(client_scores.keys())
            all_scores = [client_scores[cid] for cid in all_ids]

            best_idx = int(np.argmax(all_scores))
            winner_id = all_ids[best_idx]
            winner_score = all_scores[best_idx]

            print(f"  >> Winner client = {winner_id}, local_score = {winner_score * 100:.2f}%")

            # ③ winner 모델을 global_model + gbest로 채택
            self.global_model.load_state_dict(client_states[winner_id])

            if winner_score > self.gbest_score:
                self.gbest_score = winner_score
                self.gbest_state = copy.deepcopy(client_states[winner_id])

            # ④ 테스트 정확도 측정
            test_acc = evaluate_accuracy(self.global_model, self.test_loader, DEVICE)

            # ★ [추가 2] 리스트에 현재 라운드 정확도 추가
            acc_history.append(test_acc)

            print(f"  Test Accuracy after round {r+1}: {test_acc * 100:.2f}%")

        # ★ [추가 3] 전체 라운드 종료 후 평균 계산 및 출력
        avg_acc = sum(acc_history) / len(acc_history)
        print("\n" + "="*40)
        print(f"  Final Average Accuracy (Round 1~{num_rounds}): {avg_acc * 100:.2f}%")
        print("="*40)
        # =====================================
# Cell 7 — Federation 구성 & 학습 실행 (FedPSO)
# =====================================
def build_fedpso_federation():
    # 1) 클라이언트 인덱스 분할 (IID)
    client_indices_list = iid_client_split(train_subset, NUM_CLIENTS)

    # 2) 글로벌 모델 생성
    global_model = create_vgg19_cifar10().to(DEVICE)

    # 3) 공격자 선정
    num_attackers = int(NUM_CLIENTS * ATTACK_RATIO)
    attacker_ids = set(random.sample(range(NUM_CLIENTS), num_attackers)) if num_attackers > 0 else set()
    print("Attackers:", sorted(attacker_ids))

    # 4) 클라이언트 객체 생성
    clients: List[Client] = []
    for cid in range(NUM_CLIENTS):
        indices = client_indices_list[cid]
        is_attacker = cid in attacker_ids
        client = Client(
            client_id=cid,
            dataset=train_subset,
            indices=indices,
            is_attacker=is_attacker,
        )
        clients.append(client)

    # 5) 테스트 로더
    test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False)

    # 6) FedPSO 서버 객체
    server = FedPSOServer(global_model=global_model, clients=clients, test_loader=test_loader)
    return server
# ----- 실제 학습 실행 -----
fedpso_server = build_fedpso_federation()
fedpso_server.train(num_rounds=EPOCHS)  # EPOCHS = global rounds
