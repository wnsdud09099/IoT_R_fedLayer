# Cell 4 — Client (FedPSO용, pbest/gbest + PSO 업데이트)
# =====================================
class Client:
    def __init__(self, client_id: int, dataset, indices: List[int], is_attacker: bool = False):
        self.id = client_id
        self.dataset = Subset(dataset, indices)
        self.dataloader = DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=True)
        self.is_attacker = is_attacker

        # PSO용: 개인 최고(pbest)와 그 점수
        self.pbest_state: Dict[str, torch.Tensor] = None
        self.pbest_score: float = -1e9

        # PSO용: 속도(velocity) 벡터
        self.velocity: Dict[str, torch.Tensor] = {}

    @property
    def num_samples(self) -> int:
        return len(self.dataset)

    def _evaluate_local_accuracy(self, model: nn.Module) -> float:
        """클라이언트 로컬 데이터셋 기준 accuracy 계산."""
        model.eval()
        correct = 0
        total = 0
        with torch.no_grad():
            for images, labels in DataLoader(self.dataset, batch_size=BATCH_SIZE, shuffle=False):
                images, labels = images.to(DEVICE), labels.to(DEVICE)
                outputs = model(images)
                preds = outputs.argmax(dim=1)
                correct += (preds == labels).sum().item()
                total += labels.size(0)
        return correct / max(total, 1)

    def _pso_update_state(
        self,
        current_state: Dict[str, torch.Tensor],
        gbest_state: Dict[str, torch.Tensor],
    ) -> Dict[str, torch.Tensor]:
        """
        논문 FedPSO 구조 반영: 현재 w, pbest, gbest를 이용해
        간단한 PSO velocity 업데이트를 적용한 새 w를 만든다.
        """
        new_state: Dict[str, torch.Tensor] = {}

        # pbest가 아직 없다면 현재 상태를 pbest로 초기화
        if self.pbest_state is None:
            self.pbest_state = copy.deepcopy(current_state)

        for k in current_state.keys():
            w = current_state[k]
            pbest_w = self.pbest_state[k]
            gbest_w = gbest_state[k]

            # velocity 초기화
            if k not in self.velocity:
                self.velocity[k] = torch.zeros_like(w)

            v = self.velocity[k]

            # 랜덤 계수
            r1 = torch.rand_like(w)
            r2 = torch.rand_like(w)

            # PSO velocity 업데이트
            v_new = (
                PSO_INERTIA * v
                + PSO_C1 * r1 * (pbest_w - w)
                + PSO_C2 * r2 * (gbest_w - w)
            )

            w_new = w + v_new

            self.velocity[k] = v_new.clone()
            new_state[k] = w_new

        return new_state

    def local_train(
        self,
        global_state: Dict[str, torch.Tensor],   # 라운드 시작 시 글로벌 모델
        gbest_state: Dict[str, torch.Tensor],    # 서버가 알려주는 현재 gbest
    ) -> Tuple[Dict[str, torch.Tensor], float]:
        """
        FedPSO용 클라이언트 업데이트:
        1) global_state 로부터 모델 초기화
        2) 로컬 SGD 학습 (CLIENT_LOCAL_EPOCHS)
        3) 로컬 accuracy(=score)를 계산하고 pbest 갱신
        4) pbest, gbest를 이용해 PSO 업데이트 적용
        5) 공격자면 poisoned 상태로 변형
        6) 서버에게는 (보낼 모델 state, score)만 전달
        """

        # ① 글로벌 모델 로드
        model = create_vgg19_cifar10().to(DEVICE)
        model.load_state_dict(global_state)
        model.train()

        # BatchNorm 고정
        for m in model.modules():
            if isinstance(m, nn.BatchNorm2d):
                m.eval()

        criterion = nn.CrossEntropyLoss()
        optimizer = optim.SGD(model.trainable_params, lr=LR, momentum=MOMENTUM)

        # ② 로컬 SGD 학습
        for epoch in range(CLIENT_LOCAL_EPOCHS):
            epoch_bar = tqdm(
                self.dataloader,
                desc=f"Client {self.id} Epoch {epoch+1}/{CLIENT_LOCAL_EPOCHS}",
                leave=False,
            )
            for images, labels in epoch_bar:
                images, labels = images.to(DEVICE), labels.to(DEVICE)

                optimizer.zero_grad()
                outputs = model(images)
                loss = criterion(outputs, labels)
                loss.backward()
                # ★ [추가] 기울기 폭발 방지 (Gradient Clipping) ★
                torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
                optimizer.step()

        # SGD 후 state
        local_state = model.state_dict()

        # ③ 로컬 accuracy 기반 score 계산
        local_acc = self._evaluate_local_accuracy(model)
        score = local_acc  # 논문에서는 score를 정확도/손실 등으로 사용

        # ④ pbest 갱신
        if score > self.pbest_score:
            self.pbest_score = score
            self.pbest_state = copy.deepcopy(local_state)

        # ⑤ PSO 업데이트 적용 (pbest, gbest 기반으로 한 번 더 state 갱신)
        pso_state = self._pso_update_state(local_state, gbest_state)

        # ⑥ 공격자면 poisoned 모델로 변형 (비표적 모델 중독)
        if self.is_attacker:
            poisoned_state = create_poisoned_state_from_global(
                global_state=global_state,
                local_state=pso_state,
                alpha=ATTACK_ALPHA,
            )
            used_state = poisoned_state
        else:
            used_state = pso_state

        # 서버에는 (보낼 모델 state, score) 전달
        return used_state, score
