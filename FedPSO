IMAGENET_MEAN = (0.485, 0.456, 0.406)
IMAGENET_STD = (0.229, 0.224, 0.225)

# -----------------------------
# Federated Learning Settings (FedAvg)
# ----------------------------
NUM_CLIENTS = 10          # K
CLIENT_FRAC = 1.0         # C (0~1): 매 라운드 참여 비율 (1.0이면 전 클라이언트 참여)
EPOCHS = 10               # Global rounds
CLIENT_LOCAL_EPOCHS = 3   # 각 클라이언트 로컬 학습 에폭 수
BATCH_SIZE = 10
LR = 0.0001
MOMENTUM = 0.9

# -----------------------------
# Attack settings
# -----------------------------
ATTACK_RATIO = 0.5      # 공격자 비율 (0.0이면 전부 정상 클라이언트)
ATTACK_ALPHA = 1.5       # 비표적 모델 중독 강도 (2.0~4.0 정도에서 튜닝)

# -----------------------------
# PSO hyperparameters (FedPSO 논문 구조 반영용)
# -----------------------------
PSO_INERTIA = 0.9        # α (관성 계수, 0~1)
PSO_C1 = 0.2             # 개인 최고 위치(pbest) 가중치
PSO_C2 = 0.2             # 전역 최고 위치(gbest) 가중치
