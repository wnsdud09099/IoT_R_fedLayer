# Cell 3 — VGG19 Model (수정됨: 모든 레이어 학습 잠금 해제)
# =====================================
def create_vgg19_cifar10(num_classes: int = 10, pretrained: bool = True) -> nn.Module:
    """
    VGG19 파인 튜닝 (Fine-tuning) 모델
    - ImageNet 가중치를 가져와서 CIFAR-10에 맞게 전체를 미세 조정합니다.
    """
    if pretrained:
        try:
            model = models.vgg19(weights=VGG19_Weights.IMAGENET1K_V1)
        except Exception as e:
            print("[VGG19] WARNING: Pretrained weights not available. Using random init.", e)
            model = models.vgg19(weights=None)
    else:
        model = models.vgg19(weights=None)
        print("[VGG19] Using RANDOM init.")

    # 1) 첫 번째 MaxPool 제거 (32x32 이미지의 정보를 잃지 않기 위해)
    features_list = list(model.features.children())
    del features_list[4]
    model.features = nn.Sequential(*features_list)

    # 2) AdaptiveAvgPool 고정
    model.avgpool = nn.AdaptiveAvgPool2d((1, 1))

    # 3) Classifier 재구성 (Dropout 포함)
    model.classifier = nn.Sequential(
        nn.Flatten(),
        nn.Linear(512, 512),
        nn.ReLU(True),
        nn.Dropout(0.5), # 과적합 방지
        nn.Linear(512, 512),
        nn.ReLU(True),
        nn.Dropout(0.5), # 과적합 방지
        nn.Linear(512, num_classes),
    )

    # ★ [가장 중요한 수정] 모든 파라미터를 학습 가능하게 변경 (Unfreeze) ★
    # 이전 코드의 False를 True로 바꿉니다.
    for p in model.parameters():
        p.requires_grad = True

    # trainable param 리스트
    model.trainable_params = [p for p in model.parameters() if p.requires_grad]

    return model

# 공격용 함수는 그대로 둡니다
def create_poisoned_state_from_global(global_state, local_state, alpha=1.5):
    poisoned_state = {}
    for k in global_state.keys():
        poisoned_state[k] = global_state[k] - alpha * (local_state[k] - global_state[k])
    return poisoned_state

